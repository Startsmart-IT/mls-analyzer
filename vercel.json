{
  "version": 2,
  "env": {
    "RAPIDAPI_KEY": "@rapidapi_key"
  },
  "functions": {
    "api/**.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js",
      "methods": ["GET"]
    },
    {
      "src": "/api/search-mls",
      "dest": "/api/search-mls.js",
      "methods": ["POST"]
    },
    {
      "src": "/(.*\\..*)",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "dest": "/mls_comp_analyzer.html"
    }
  ]
}