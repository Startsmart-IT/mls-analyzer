{
  "version": 2,
  "builds": [
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search-mls.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/search-mls",
      "dest": "/api/search-mls.js"
    },
    {
      "src": "/(.*)",
      "dest": "/mls_comp_analyzer.html"
    }
  ]
}